// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateRust 固定样本 > 输出快照 1`] = `
"#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
pub struct Address {
    pub city: String,
    pub zip: i64,
}

#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
pub struct Item {
    pub sku: String,
    pub qty: i64,
    pub price: f64,
}

#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
pub struct ApiResponse {
    pub id: i64,
    pub name: String,
    pub score: f64,
    pub active: bool,
    pub nickname: Option<serde_json::Value>,
    #[serde(rename = "user-name")]
    pub user_name: String,
    #[serde(rename = "firstName")]
    pub first_name: String,
    #[serde(rename = "type")]
    pub type_: String,
    pub tags: Vec<String>,
    pub address: Address,
    pub items: Vec<Item>,
}"
`;
